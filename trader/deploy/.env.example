# copy to trader/.env ; never commit .env
TRADER_MODE=paper                 # paper | live
TRADER_STRATEGY=p1                # p1 | p1_longflat | bstar_long | r3
TRADER_UNIVERSE=research22        # research22 (paper) | evm_arbitrum (live)
TRADER_RUN_ID=p1_paper
TRADER_EXTRA_ARGS=                # e.g. "--dry-run" for a live rehearsal that signs nothing
# live only
RPC_URL=https://arb1.arbitrum.io/rpc
TRADER_WALLET_PRIVATE_KEY=        # hot wallet holding only the trading capital (USDC + a little ETH for gas)
SUSHI_API_KEY=                    # optional, from sushi.com/portal
